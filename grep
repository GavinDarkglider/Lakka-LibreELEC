-        ret =
-            req_buffers_on_capture_plane(ctx,
-                                         V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE,
-                                         ctx->cp_mem_type, 0);
-
-        /* Destroy DMA buffers. */
-        if (ctx->cp_mem_type == V4L2_MEMORY_DMABUF) {
-            for (uint32_t i = 0; i < ctx->cp_num_buffers; ++i) {
-                if (ctx->dmabuff_fd[i] != 0) {
