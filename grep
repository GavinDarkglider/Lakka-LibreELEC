-static int
-dq_event(context_t * ctx, struct v4l2_event *event, uint32_t max_wait_ms)
-{
-    int ret_val;
-    do {
-        ret_val = v4l2_ioctl(ctx->fd, VIDIOC_DQEVENT, event);
-
-        if (errno != EAGAIN) {
-            break;
-        } else if (max_wait_ms-- == 0) {
-            break;
-        } else {
-            usleep(1000);
-        }
-    }
-    while (ret_val && (ctx->op_streamon || ctx->cp_streamon));
-
-    return ret_val;
-}
