-            if (ctx->bufptr_0[index] != NULL) {
-                free(ctx->bufptr_0[index]);
-                ctx->bufptr_0[index] = NULL;
-            }
-            if (ctx->bufptr_1[index] != NULL) {
-                free(ctx->bufptr_1[index]);
