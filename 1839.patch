-    PKG_MAKE_OPTS_TARGET+=" AS=${AS} CC_AS=${AS}"
-  fi
-}
-
-makeinstall_target() {
-  mkdir -p ${INSTALL}/usr/lib/libretro
-    cp -v flycast_libretro.so ${INSTALL}/usr/lib/libretro/
-}

