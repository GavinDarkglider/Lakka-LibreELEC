--	unsigned long arm_ip;
--	unsigned long arm_sp;
--	unsigned long arm_lr;
--	unsigned long arm_pc;
--	unsigned long arm_cpsr;
--	unsigned long fault_address;
--};
--#endif /* CONFIG_64BIT */
